# Haushelden configuration (SPEC-0007 "Configuration Keys", ADR-0004).
# Copy to .env for local development. Real values live only in the private homelab repository.
# Everything below is a placeholder.

# development (default) or production. In production, missing required keys stop startup.
HH_MODE=development

# Public base URL behind the reverse proxy (invite links, CORS). Required in production.
HH_PUBLIC_URL=http://127.0.0.1:8090

# Household time zone (default Europe/Berlin).
HH_TZ=Europe/Berlin

# PocketBase data directory (default ./pb_data).
HH_DATA_DIR=./pb_data

# Address PocketBase listens on (default 127.0.0.1:8090).
HH_LISTEN=127.0.0.1:8090

# One-time token for first-run setup. Required on a fresh install in production.
HH_SETUP_TOKEN=change-me

# Where nightly backups are written (path or URL). Required in production.
HH_BACKUP_TARGET=change-me

# Number of daily backups kept (default 14).
HH_BACKUP_RETENTION_DAYS=14

# Pinned PocketBase version (also used by scripts/pb-download.sh). Required in production.
HH_PB_VERSION=0.40.5

# Later: family calendar source (SPEC-0004).
HH_CALDAV_URL=change-me
HH_CALDAV_USER=change-me
HH_CALDAV_PASSWORD=change-me

# Later: household assistant (SPEC-0006).
HH_ASSISTANT_TOKEN=change-me
HH_LLM_ENDPOINT=change-me

# Local development only (ignored in production): fake superuser created by `npm start` and used by `npm run seed`.
HH_DEV_ADMIN_EMAIL=admin@example.test
HH_DEV_ADMIN_PASSWORD=change-me-dev-only
