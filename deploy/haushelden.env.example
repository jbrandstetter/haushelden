# Governing: ADR-0004 (placeholders only; the real file lives in the private provisioning repository)
# Env file read by the systemd units (EnvironmentFile). Keys are documented in .env.example.
HH_MODE=production
HH_PUBLIC_URL=change-me
HH_LISTEN=127.0.0.1:8090
HH_DATA_DIR=/var/lib/haushelden
HH_TZ=Europe/Berlin
HH_BACKUP_TARGET=change-me
HH_BACKUP_RETENTION_DAYS=14
HH_PB_VERSION=0.40.5
HH_SETUP_TOKEN=change-me
